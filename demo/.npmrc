# Require npm 10+ (see "engines" in package.json) and fail fast if it's older.
#
# Why: `npm install` recomputes the dependency tree for the current platform and
# old npm (<10) PRUNES cross-platform optional deps such as @emnapi/core and
# @emnapi/runtime (needed on linux/CI but not on macOS/arm). That silently
# rewrites package-lock.json and breaks `npm ci` in GitHub Actions. npm 10+
# keeps those entries. engine-strict turns the version mismatch into an error
# instead of a silent lockfile corruption.
engine-strict=true
